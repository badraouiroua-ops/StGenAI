# ── Clés API Gemini ───────────────────────────────────────────────────────────
# Modèle de configuration. Copier ce fichier en `.env` puis compléter.
# `.env` est ignoré par git : ne jamais mettre de vraies clés ici.

# ── Fallback mono-clé ─────────────────────────────────────────────────────────
# Utilisée uniquement si le fichier `.env` est absent.
GEMINI_API_KEY=AIza...

# ── Rotation par pools (recommandé pour éviter les 429) ───────────────────────
# Chaque ligne GEMINI_KEY_N est chargée dans l'ORDRE du fichier par
# BatchLLMValidation.load_api_keys().
# L'index N (1-based) doit correspondre aux pools définis dans api_config.json :
#   pool_A = 1-10   pool_B = 11-18   pool_C = 19-25   pool_D = 26-34
#   pool_E = 35-44  pool_F = 45-54   pool_G = 55-64   pool_H = 65-74
#   pool_I = 75-84
# Idéalement, chaque clé appartient à un projet Google Cloud DISTINCT.

GEMINI_KEY_1=AIza...
GEMINI_KEY_2=AIza...
GEMINI_KEY_3=AIza...
GEMINI_KEY_4=AIza...
GEMINI_KEY_5=AIza...
GEMINI_KEY_6=AIza...
